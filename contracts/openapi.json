{
  "openapi": "3.1.0",
  "info": {
    "title": "DealRadar CA",
    "description": "Canadian localized source-reported offers. Verification and coverage are explicit.",
    "version": "0.2.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/locations/resolve": {
      "get": {
        "summary": "Resolve",
        "operationId": "resolve_v1_locations_resolve_get",
        "parameters": [
          {
            "name": "postal_code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Postal Code"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/search": {
      "post": {
        "summary": "Search",
        "operationId": "search_v1_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "503": {
            "description": "All enabled feeds failed"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/searches/{search_id}": {
      "get": {
        "summary": "Search Result",
        "operationId": "search_result_v1_searches__search_id__get",
        "parameters": [
          {
            "name": "search_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Search Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/offers/{offer_id}": {
      "get": {
        "summary": "Offer",
        "operationId": "offer_v1_offers__offer_id__get",
        "parameters": [
          {
            "name": "offer_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Offer Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Offer"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/items/{item_id}/offers": {
      "get": {
        "summary": "Item Offers",
        "operationId": "item_offers_v1_items__item_id__offers_get",
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Item Id"
            }
          },
          {
            "name": "postal_code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Postal Code"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/items/{item_id}/history": {
      "get": {
        "summary": "History",
        "operationId": "history_v1_items__item_id__history_get",
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Item Id"
            }
          },
          {
            "name": "postal_code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Postal Code"
            }
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 365,
              "minimum": 1,
              "default": 90,
              "title": "Days"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sources/status": {
      "get": {
        "summary": "Statuses",
        "operationId": "statuses_v1_sources_status_get",
        "parameters": [
          {
            "name": "postal_code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Postal Code"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/deals/top": {
      "get": {
        "summary": "Top",
        "operationId": "top_v1_deals_top_get",
        "parameters": [
          {
            "name": "postal_code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Postal Code"
            }
          },
          {
            "name": "period",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(day|week)$",
              "default": "day",
              "title": "Period"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/basket/quote": {
      "post": {
        "summary": "Basket",
        "operationId": "basket_v1_basket_quote_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BasketRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BasketLine": {
        "properties": {
          "offer_id": {
            "type": "string",
            "format": "uuid",
            "title": "Offer Id"
          },
          "quantity": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "offer_id",
          "quantity"
        ],
        "title": "BasketLine"
      },
      "BasketRequest": {
        "properties": {
          "postal_code": {
            "type": "string",
            "title": "Postal Code"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/BasketLine"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "postal_code",
          "items"
        ],
        "title": "BasketRequest"
      },
      "ComparisonGroup": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "unit_basis": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit Basis"
          },
          "offers": {
            "items": {
              "$ref": "#/components/schemas/Offer"
            },
            "type": "array",
            "title": "Offers"
          }
        },
        "type": "object",
        "required": [
          "key",
          "unit_basis",
          "offers"
        ],
        "title": "ComparisonGroup"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Offer": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "item_id": {
            "type": "string",
            "format": "uuid",
            "title": "Item Id"
          },
          "product_name": {
            "type": "string",
            "title": "Product Name"
          },
          "store": {
            "type": "string",
            "title": "Store"
          },
          "fsa": {
            "type": "string",
            "title": "Fsa"
          },
          "postal_scope": {
            "type": "string",
            "title": "Postal Scope"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "currency": {
            "type": "string",
            "const": "CAD",
            "title": "Currency",
            "default": "CAD"
          },
          "sale_price": {
            "type": "string",
            "title": "Sale Price"
          },
          "price_basis": {
            "type": "string",
            "enum": [
              "package",
              "g",
              "kg",
              "lb",
              "ml",
              "l",
              "roll",
              "unit"
            ],
            "title": "Price Basis",
            "default": "package"
          },
          "regular_price": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Regular Price"
          },
          "unit_price": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit Price"
          },
          "unit_basis": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit Basis"
          },
          "comparison_group": {
            "type": "string",
            "title": "Comparison Group"
          },
          "conditions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Conditions"
          },
          "valid_from": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valid From"
          },
          "valid_to": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valid To"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Observed At"
          },
          "verified_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verified At"
          },
          "price_verified": {
            "type": "boolean",
            "title": "Price Verified",
            "default": false
          },
          "coverage_verified": {
            "type": "boolean",
            "title": "Coverage Verified",
            "default": false
          },
          "reference_price_kind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference Price Kind"
          }
        },
        "type": "object",
        "required": [
          "id",
          "item_id",
          "product_name",
          "store",
          "fsa",
          "postal_scope",
          "source",
          "sale_price",
          "comparison_group",
          "observed_at"
        ],
        "title": "Offer"
      },
      "SearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 250,
            "minLength": 1,
            "title": "Query"
          },
          "postal_code": {
            "type": "string",
            "maxLength": 7,
            "minLength": 3,
            "title": "Postal Code"
          },
          "locale": {
            "type": "string",
            "enum": [
              "en-ca",
              "fr-ca"
            ],
            "title": "Locale",
            "default": "en-ca"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query",
          "postal_code"
        ],
        "title": "SearchRequest"
      },
      "SearchResponse": {
        "properties": {
          "search_id": {
            "type": "string",
            "format": "uuid",
            "title": "Search Id"
          },
          "query": {
            "type": "string",
            "title": "Query"
          },
          "postal_code": {
            "type": "string",
            "title": "Postal Code"
          },
          "fsa": {
            "type": "string",
            "title": "Fsa"
          },
          "approximate_location": {
            "type": "boolean",
            "title": "Approximate Location"
          },
          "groups": {
            "items": {
              "$ref": "#/components/schemas/ComparisonGroup"
            },
            "type": "array",
            "title": "Groups"
          },
          "community": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Community"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceStatus"
            },
            "type": "array",
            "title": "Sources"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "cached": {
            "type": "boolean",
            "title": "Cached",
            "default": false
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Completed At"
          }
        },
        "type": "object",
        "required": [
          "search_id",
          "query",
          "postal_code",
          "fsa",
          "approximate_location",
          "groups",
          "sources",
          "completed_at"
        ],
        "title": "SearchResponse"
      },
      "SourceStatus": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "partial",
              "error",
              "disabled",
              "not_checked"
            ],
            "title": "Status"
          },
          "checked_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checked At"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "item_count": {
            "type": "integer",
            "title": "Item Count",
            "default": 0
          },
          "rejected_count": {
            "type": "integer",
            "title": "Rejected Count",
            "default": 0
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "source",
          "status"
        ],
        "title": "SourceStatus"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
